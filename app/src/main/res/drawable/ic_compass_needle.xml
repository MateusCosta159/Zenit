<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_compass_needle.xml
    Agulha clássica: ponta vermelha aponta para o Norte, ponta branca para o Sul.
    Centralizada em 280x280dp (viewBox 0 0 280 280) para coincidir com o FrameLayout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="280dp"
    android:height="280dp"
    android:viewportWidth="280"
    android:viewportHeight="280">

    <!-- Ponta Norte (vermelha) -->
    <path
        android:fillColor="#E53935"
        android:pathData="M140,40 L148,140 L132,140 Z"/>

    <!-- Ponta Sul (branca) -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M140,240 L148,140 L132,140 Z"/>

    <!-- Centro da agulha -->
    <path
        android:fillColor="#0D1B0F"
        android:strokeColor="#A8D5A2"
        android:strokeWidth="1.5"
        android:pathData="M140,140 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"/>

</vector>