<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1F1A"
    tools:context=".ui.DashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSaudacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá, usuário"
                        android:textColor="#7FB98A"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meu Jardim"
                        android:textColor="#E8F5E2"
                        android:textSize="24sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <!-- Botão Bússola -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBussola"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="🧭"
                    android:textColor="#0D1F1A"
                    android:textSize="16sp"
                    app:backgroundTint="#7FB98A"
                    app:cornerRadius="10dp" />

                <!-- Botão Adicionar Planta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdicionarPlanta"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="+ Planta"
                    android:textColor="#0D1F1A"
                    android:textSize="13sp"
                    app:backgroundTint="#7FB98A"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Cards de sensores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <!-- Card Temperatura -->
                <LinearLayout
                    android:id="@+id/cardTemperatura"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_sensor_card"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌡️"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvTemperatura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textColor="#E8F5E2"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura"
                        android:textColor="#7FB98A"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Card Luminosidade -->
                <LinearLayout
                    android:id="@+id/cardLuminosidade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_sensor_card"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvLuminosidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- lx"
                        android:textColor="#E8F5E2"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Luminosidade"
                        android:textColor="#7FB98A"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Título da lista -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suas plantas"
                android:textColor="#E8F5E2"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:layout_marginBottom="12dp" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/layoutVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhuma planta cadastrada"
                    android:textColor="#3D5C45"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Lista de plantas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlantas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>