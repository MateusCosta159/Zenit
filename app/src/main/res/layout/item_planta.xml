<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#122318"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Foto da planta -->
        <ImageView
            android:id="@+id/imgPlanta"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_glow_circle"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Foto da planta" />

        <!-- Dados -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNomePlanta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome da planta"
                android:textColor="#E8F5E2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAmbiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambiente"
                android:textColor="#7FB98A"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Seta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#3D5C45"
            android:textSize="24sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>