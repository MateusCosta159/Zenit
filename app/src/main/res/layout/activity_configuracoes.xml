<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1F1A">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0D1F1A"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Configurações"
        app:titleTextColor="#E8F5E2" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Card Perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_sensor_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERFIL"
                    android:textColor="#7FB98A"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="36sp"
                    android:layout_gravity="center_horizontal"/>

                <TextView
                    android:id="@+id/tvNomeUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuário"
                    android:textColor="#E8F5E2"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvEmailUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@exemplo.com"
                    android:textColor="#7FB98A"
                    android:textSize="13sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Card Alertas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_sensor_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIMITES DE ALERTA"
                    android:textColor="#7FB98A"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="20dp"/>

                <!-- Temperatura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌡️  Temperatura máxima"
                        android:textColor="#E8F5E2"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvLimiteTemperatura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35°C"
                        android:textColor="#7FB98A"
                        android:textSize="14sp"
                        android:fontFamily="serif"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTemperatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="15"
                    android:progressTint="#7FB98A"
                    android:thumbTint="#7FB98A"
                    android:layout_marginBottom="20dp"/>

                <!-- Luminosidade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☀️  Luminosidade mínima"
                        android:textColor="#E8F5E2"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvLimiteLuminosidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 lx"
                        android:textColor="#7FB98A"
                        android:textSize="14sp"
                        android:fontFamily="serif"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekLuminosidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="500"
                    android:progress="100"
                    android:progressTint="#7FB98A"
                    android:thumbTint="#7FB98A"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarLimites"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Salvar limites"
                    android:textColor="#0D1F1A"
                    android:textSize="14sp"
                    app:backgroundTint="#7FB98A"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <!-- Card Sobre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_sensor_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOBRE O APP"
                    android:textColor="#7FB98A"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zenit — Rastreador Solar e Térmico"
                    android:textColor="#E8F5E2"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versão 1.0.0  ·  IFSP Araraquara · 2026"
                    android:textColor="#7FB98A"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Botão Sair -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sair da conta"
                android:textColor="#E8F5E2"
                android:textSize="14sp"
                app:backgroundTint="#1A2E1C"
                app:strokeColor="#3D5C45"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>